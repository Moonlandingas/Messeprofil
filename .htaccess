# Generert fra vercel.json – 301-redirects fra gamle WordPress-URL-er
# Vedlikehold: endre i vercel.json og regenerer, ikke rediger for haand her.

<IfModule mod_rewrite.c>
RewriteEngine On

# --- Bot-blokkering: legacy WooCommerce-parameter "add-to-cart" i query-strengen ---
# Datasenter-boter spiller av gamle WooCommerce-URL-er (?add-to-cart=<id>&min_price=...).
# Den nye siden bruker ikke parameteren til noe (verifisert: null treff i hele repoet).
# 301 til samme path UTEN query-streng, foer HTML serveres - ingen tracking-tagger lastes.
# Speiles som foerste oppfoering i "redirects" i vercel.json.
RewriteCond %{QUERY_STRING} (^|&)add-to-cart(=|&|$) [NC]
RewriteRule ^ %{REQUEST_URI}? [R=301,L]

# --- Stage-blokkering: KUN stage.messeprofil.no (hostbetinget) ---
RewriteCond %{HTTP_HOST} ^stage\. [NC]
RewriteRule ^robots\.txt$ robots-stage.txt [L]

# --- Eksakte redirects (med og uten avsluttende skraastrek) ---
