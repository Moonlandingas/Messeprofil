# --- Noindex-header KUN paa stage (SetEnvIf virker paa Apache og LiteSpeed) ---
<IfModule mod_setenvif.c>
SetEnvIf Host "^stage\." STAGE_ENV
</IfModule>
<IfModule mod_headers.c>
Header set X-Robots-Tag "noindex, nofollow" env=STAGE_ENV
</IfModule>
